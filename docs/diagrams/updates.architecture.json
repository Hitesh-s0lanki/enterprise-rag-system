  "cards": [
    {
      "dot": "cyan",
      "title": "Trusted access",
      "items": [
        "Identity and namespace are application-bound. Every operation reads current permission bits and catalog reader/writer ACLs. Administrator document access still requires action bits and namespace scope.",
        "An explicit request supplies intent, not permissions. Unregistered documents fail closed; tools cannot create documents or change ACLs."
      ]
    },
    {
      "dot": "emerald",
      "title": "Read before editing",
      "items": [
        "Read the full authoritative source and revision before generating a complete replacement. Search snippets cannot replace this read.",
        "Stale revisions or a concurrent staged update cause revision_conflict. Unchanged content returns without uploads."
      ]
    },
    {
      "dot": "rose",
      "title": "Publish only verified revisions",
      "items": [
        "Recheck authorization before upload and inside staging/publication transactions. Verify every new chunk before moving the catalog head.",
        "Failures preserve the old head until publication succeeds and may leave orphan chunks. Interrupted results require inspection; never blindly repeat writes. Search visibility may lag publication."
      ]
    },
    {
      "dot": "cyan",
      "title": "Return and future reads",
      "items": [
        "Only status=published confirms the update. Return the document ID and old/new revision IDs to the root.",
        "Subsequent reads follow published heads within approved scope. The revision-based Mem0 context excludes older cached reports; old data is not deleted."
      ]
    }
  ]
