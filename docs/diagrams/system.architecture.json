  "cards": [
    {
      "dot": "cyan",
      "title": "Client and agent",
      "items": [
        "The client sends a request. The root agent selects one or both search tools.",
        "Tools return evidence to the root agent, which prepares the final reply. Query enhancement runs only inside the Firecrawl tool."
      ]
    },
    {
      "dot": "emerald",
      "title": "Firecrawl cycle",
      "items": [
        "Firecrawl → Jev grading inside the tool middleware. Accepted evidence returns directly to the root agent.",
        "Low grade → query enhancement agent → Firecrawl → grade again against the original query. At most two enhancements; no direct root-to-enhancement connection.",
        "After the retry limit, return the final results and grades even when evidence remains insufficient. Scrape and map are ungraded."
      ]
    },
    {
      "dot": "rose",
      "title": "Knowledge cycle",
      "items": [
        "Search knowledge → previously seen question in Mem0? Yes → validate and return the saved Jev-graded report. Cached documents are not regraded.",
        "No usable match → Pinecone → Jev document grading → save eligible sufficient reports in Mem0 → return to root. Insufficient evidence returns without saving.",
        "use_memory=false skips Mem0 reads and writes. Cache write failure preserves the fresh report."
      ]
    },
    {
      "dot": "cyan",
      "title": "Document updates",
      "items": [
        "Explicit edit → current RBAC and stored document ACLs → full-source read → revision check → upload and verify → reauthorize and publish.",
        "Denied access stops the operation. Only a committed published status confirms the change. See Inside document updates for conflict and failure routes."
      ]
    }
  ],
