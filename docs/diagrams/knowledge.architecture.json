  "cards": [
    {
      "dot": "cyan",
      "title": "Memory routing",
      "items": [
        "use_memory=false skips all Mem0 reads and writes. A bypassed fresh report returns directly to the agent.",
        "A cache miss, Mem0 operation error or rejected candidate triggers fresh retrieval. Invalid request or access denial stops the call."
      ]
    },
    {
      "dot": "emerald",
      "title": "Cache validation",
      "items": [
        "Exact repeats skip the equivalence model call; paraphrases require Jev to verify the same information is requested.",
        "Check TTL, context, user scope, digest, current permissions and approved revisions. Cached content is a retrieval/grading report, not a generated answer.",
        "A valid Mem0 hit returns saved Jev document grades; it does not run fresh document grading. Paraphrase verification grades query equivalence only."
      ]
    },
    {
      "dot": "rose",
      "title": "Fresh evidence and output",
      "items": [
        "External mode uses OpenAI query embeddings; integrated mode embeds through Pinecone. Both dense and BM25 results are required.",
        "Fusion deduplicates chunks and ranks them. Jev grades every returned chunk; only sufficient, validated reports within the payload limit are written to Mem0."
      ]
    },
    {
      "dot": "cyan",
      "title": "Return and recovery",
      "items": [
        "The tool returns documents, grading, source and metrics. The agent writes the final answer or chooses another bounded tool call.",
        "Insufficient or empty evidence is returned without caching. Provider retrieval/grading errors become tool errors; a failed cache write preserves the fresh report."
      ]
    }
  ],
