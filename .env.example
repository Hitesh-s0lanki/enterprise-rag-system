# Copy these settings into .env and replace the API key placeholders.
# The application CLIs load .env; existing environment variables take precedence.
# Pinecone credentials are required for live ingestion, but not for --dry-run.

# SQLite auth database. Streamlit startup initializes auth and the document catalog automatically.
# The optional document edit catalog uses this same database; see docs/document-update-tools.md.
# Default location without this override: <project-root>/.local/auth.sqlite3
AUTH_DB_PATH=.local/auth.sqlite3

# OpenAI: required for agent generation and external embeddings; Pinecone-integrated OpenAI
# embeddings use Pinecone's embedding service instead of this direct API key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the Pinecone embedding field's dimension.
OPENAI_EMBEDDING_DIMENSIONS=1536

# Shared agent chat-model defaults. Entry points load .env before building agents.
AGENT_MODEL=gpt-4.1-mini
# "none" leaves temperature to the provider; set a number only if the model supports it.
AGENT_TEMPERATURE=none
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=2
# Combined user query + reference context limit (characters, not tokens).
AGENT_MAX_INPUT_CHARACTERS=16000

# Shared BaseAgent execution defaults for future agents.
AGENT_RUN_MAX_MODEL_CALLS=4
AGENT_RUN_MAX_TOOL_CALLS=6
AGENT_RUN_TIMEOUT_SECONDS=120

# Root-agent execution limits; tools remain bound to the trusted application user.
ROOT_AGENT_MAX_MODEL_CALLS=4
ROOT_AGENT_MAX_TOOL_CALLS=6
ROOT_AGENT_TIMEOUT_SECONDS=120

# Structured application logs: stderr + rotating JSONL file. Empty LOG_FILE disables file output.
LOG_LEVEL=INFO
LOG_FILE=.local/logs/app.jsonl
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# Optional Firecrawl public-web tools, enabled when a real API key is configured.
# Search evidence grading also requires TYPESAFE_API_KEY; weak searches use the
# shared AGENT_* OpenAI model for at most two query enhancements inside the tool.
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_ENABLED=true
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp
# Per-attempt deadline includes connection, MCP initialization and execution.
FIRECRAWL_TIMEOUT_SECONDS=30
# Retries after the first attempt (0-5); exponential delay capped at 10 seconds.
FIRECRAWL_MAX_RETRIES=2
FIRECRAWL_RETRY_DELAY_SECONDS=1

# Pinecone: stores document chunks, vectors and metadata.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=enterprise-it-knowledge
# Logical partition within the index.
PINECONE_NAMESPACE=it-support
# Used only when creating a missing index with --create-index.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Recursive character splitting: sizes are characters, not tokens.
INGESTION_CHUNK_SIZE=1000
# Must be smaller than INGESTION_CHUNK_SIZE.
INGESTION_CHUNK_OVERLAP=150
# Number of chunks per embedding/upsert batch; allowed range: 1-100.
INGESTION_BATCH_SIZE=64

# Hybrid retrieval: return top_k chunks from candidate_k results per search signal.
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
# Semantic weight; keyword weight is 1 minus this value. Both must be positive.
RETRIEVAL_DENSE_WEIGHT=0.7
# Reciprocal rank fusion smoothing constant (ranking score, not an answer grade).
RETRIEVAL_RRF_K=60
RETRIEVAL_TIMEOUT_SECONDS=30
RETRIEVAL_MAX_QUERY_CHARACTERS=4000

# TypeSafe AI Jev: used by the shared client for evaluation requests.
# Applications must load .env before constructing the client.
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
# HTTP operation timeout in seconds; the SDK controls the retry time budget.
TYPESAFE_TIMEOUT_SECONDS=30
# Retries after the initial attempt; 0 disables retries.
TYPESAFE_MAX_RETRIES=2

# Query/document grading: normalized relevance and sufficient-evidence probability.
GRADING_RELEVANCE_THRESHOLD=0.6
GRADING_EVIDENCE_THRESHOLD=0.7
# Grading rejects oversized inputs before sending any document to Jev.
GRADING_MAX_DOCUMENTS=20
GRADING_MAX_DOCUMENT_CHARACTERS=20000
GRADING_MAX_QUERY_CHARACTERS=4000

# Mem0 Platform: entity-scoped agent memory (add/search conversation facts).
# Applications must load .env before constructing the client.
MEM0_API_KEY=your_mem0_api_key_here
MEM0_BASE_URL=https://api.mem0.ai
# HTTP operation timeout in seconds.
MEM0_TIMEOUT_SECONDS=30

# Opt in with retrieval --grade --memory-cache. Store complete successful reports.
# Mem0 score selects candidates; query-only Jev verification gates paraphrase reuse.
MEM0_CACHE_SIMILARITY_THRESHOLD=0.3
MEM0_CACHE_EQUIVALENCE_THRESHOLD=0.85
MEM0_CACHE_TTL_SECONDS=900
MEM0_CACHE_TOP_K=5
MEM0_CACHE_MAX_PAYLOAD_BYTES=256000

# Source editor and reader roles are CLI arguments, not environment settings:
# --user bob --updated-by YOUR_USERNAME --allowed-role contributor
# Optional source update time: --updated-at 2026-11-16T17:00:00+05:30
